.DS_Store
Thumbs.db

# Frontend (SvelteKit/Vite)
frontend/node_modules/
frontend/.svelte-kit/
frontend/.vite/

# Test artefacts (generated by run_tests.py / pytest report output)
tests/features/pytest_report.xml
tests/features/.tmp_pytest_out.txt

# Review/working notes (not part of the project)
notes/
notes_*.txt
