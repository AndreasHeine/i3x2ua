# Local environment template for i3x_server
# Source of truth: i3x_server/config/settings.py, i3x_server/main.py, run.py

# Network binding
# I3X_HOST: Bind address (default: 0.0.0.0).
I3X_HOST=0.0.0.0
# I3X_PORT: HTTP port (default: 8000).
I3X_PORT=8000

# OPC UA connection
# For Docker Compose, use host.docker.internal instead of 127.0.0.1 when the OPC UA server runs on the host.
# I3X_OPCUA_ENDPOINT: OPC UA endpoint URL (default: opc.tcp://opcua.umati.app:4843).
I3X_OPCUA_ENDPOINT=opc.tcp://opcua.umati.app:4843
# I3X_OPCUA_USERNAME: OPC UA username (default: empty).
I3X_OPCUA_USERNAME=
# I3X_OPCUA_PASSWORD: OPC UA password (default: empty).
I3X_OPCUA_PASSWORD=

# OPC UA security
# I3X_OPCUA_SECURITY_MODE: Security mode (None, Sign, SignAndEncrypt; default: None).
I3X_OPCUA_SECURITY_MODE=None
# I3X_OPCUA_SECURITY_POLICY: Security policy URI short name (e.g. Basic256Sha256; default: unset).
# Leave unset for security mode None; set it together with Sign or SignAndEncrypt.
I3X_OPCUA_SECURITY_POLICY=
# I3X_OPCUA_CLIENT_CERT_PATH / I3X_OPCUA_CLIENT_KEY_PATH: Client certificate and private key
# (default: unset, i.e. no certificate material). Uncomment both for signed/encrypted transport.
# Generate the bundle first: uv run python scripts/generate_opcua_client_cert.py
# (no PEM material is tracked by git).
# I3X_OPCUA_CLIENT_CERT_PATH=./certs/opcua-client-sample/client-cert.pem
# I3X_OPCUA_CLIENT_KEY_PATH=./certs/opcua-client-sample/client-key.pem
# I3X_OPCUA_CLIENT_KEY_PASSWORD: Client key password (default: empty).
I3X_OPCUA_CLIENT_KEY_PASSWORD=
# I3X_OPCUA_SERVER_CERT_PATH: Server certificate path for validation (default: None).
I3X_OPCUA_SERVER_CERT_PATH=

# OPC UA/model performance tuning
# I3X_OPCUA_BROWSE_CONCURRENCY: Browse concurrency (default: 128).
I3X_OPCUA_BROWSE_CONCURRENCY=128
# I3X_OPCUA_READ_CONCURRENCY: Concurrent attribute/value read round-trips per request handler (default: 64).
I3X_OPCUA_READ_CONCURRENCY=64
# I3X_OPCUA_REFRESH_CONCURRENCY: Concurrent round-trips for background model refreshes (default: 32).
I3X_OPCUA_REFRESH_CONCURRENCY=32
# I3X_OPCUA_METADATA_CACHE_TTL_SECONDS: Metadata cache TTL in seconds (default: 300).
I3X_OPCUA_METADATA_CACHE_TTL_SECONDS=300
# I3X_OPCUA_CONNECTION_MONITOR_INTERVAL_SECONDS: asyncua connection watchdog interval in seconds; also the
# health-probe timeout (default: 5).
I3X_OPCUA_CONNECTION_MONITOR_INTERVAL_SECONDS=5
# I3X_OPCUA_RECONNECT_REQUEST_TIMEOUT_SECONDS: Max seconds a request waits for a running reconnect (default: 10).
I3X_OPCUA_RECONNECT_REQUEST_TIMEOUT_SECONDS=10
# I3X_OPCUA_RECONNECT_MAX_DELAY_SECONDS: Max backoff between reconnect attempts in seconds (default: 30).
I3X_OPCUA_RECONNECT_MAX_DELAY_SECONDS=30
# I3X_MODEL_REFRESH_INTERVAL_SECONDS: Model refresh interval in seconds (default: 0 = disabled).
# The compose stack sets 60 so a long-running container keeps the model fresh.
I3X_MODEL_REFRESH_INTERVAL_SECONDS=0
# I3X_OPCUA_BROWSE_ROOTS: '["nsu=urn:example:plant;s=Machine1","nsu=urn:example:plant;s=Machine2"]'

# Startup and preload behavior
# I3X_MODEL_PRELOAD_ON_STARTUP: Preload the model on startup (default: true).
I3X_MODEL_PRELOAD_ON_STARTUP=true
# I3X_MODEL_PRELOAD_BLOCKING: Block startup until preload completes (default: false).
I3X_MODEL_PRELOAD_BLOCKING=false
# I3X_FAIL_STARTUP_ON_MODEL_PRELOAD_ERROR: Fail startup on preload errors (default: false).
I3X_FAIL_STARTUP_ON_MODEL_PRELOAD_ERROR=false

# Subscription behavior
# I3X_SUBSCRIPTIONS_INITIAL_VALUES: Seed initial values on subscription registration (default: true).
I3X_SUBSCRIPTIONS_INITIAL_VALUES=true
# I3X_SUBSCRIPTION_INTERVAL_SECONDS: Subscription update interval in seconds (default: 5.0).
I3X_SUBSCRIPTION_INTERVAL_SECONDS=5
# I3X_SUBSCRIPTION_MAX_UPDATES: Max updates retained per subscription (default: 10000).
I3X_SUBSCRIPTION_MAX_UPDATES=10000
# I3X_SUBSCRIPTION_TTL_SECONDS: Subscription TTL in seconds (default: 300).
I3X_SUBSCRIPTION_TTL_SECONDS=300
# I3X_SUBSCRIPTION_NATIVE_TIMEOUT_REFRESH_MODE: How a native subscription recovers when the server
# sends no notifications: adaptive (default), hybrid, or strict.
I3X_SUBSCRIPTION_NATIVE_TIMEOUT_REFRESH_MODE=adaptive
# I3X_SUBSCRIPTION_NATIVE_TIMEOUT_REFRESH_KEEPALIVES: Keepalive count that derives the refresh cadence
# from the revised publishing interval (default: 3).
I3X_SUBSCRIPTION_NATIVE_TIMEOUT_REFRESH_KEEPALIVES=3
# I3X_SUBSCRIPTION_NATIVE_TIMEOUT_REFRESH_MAX_SECONDS: Upper bound of that derived refresh cadence
# (default: 30).
I3X_SUBSCRIPTION_NATIVE_TIMEOUT_REFRESH_MAX_SECONDS=30
# I3X_SUBSCRIPTION_MAX_CONCURRENT_NATIVE_ADMISSIONS: Concurrent native OPC UA admissions, i.e. how
# many monitored-item round-trips may be in flight at once (default: 4).
I3X_SUBSCRIPTION_MAX_CONCURRENT_NATIVE_ADMISSIONS=4
# I3X_SUBSCRIPTION_NATIVE_BACKOFF_SECONDS: Pause of native admissions after the server reports a
# subscription/session limit, so retries do not fail identically in a burst (default: 30).
I3X_SUBSCRIPTION_NATIVE_BACKOFF_SECONDS=30
# Admission limits (gateway-side, not part of the i3X contract). Violations answer the regular
# error envelope: 429 for the subscription count cap, 400 for the monitored-item budget and for
# composition depth beyond I3X_COMPOSITION_MAX_DEPTH.
# I3X_SUBSCRIPTION_MAX_COUNT: Subscriptions a single process may track (default: 1000).
I3X_SUBSCRIPTION_MAX_COUNT=1000
# I3X_SUBSCRIPTION_MAX_PER_CLIENT: Subscriptions one clientId scope may track (default: 100).
# Requests over the bound answer 429; clients without a clientId are indistinguishable and share
# one bucket.
I3X_SUBSCRIPTION_MAX_PER_CLIENT=100
# I3X_SUBSCRIPTION_SUBTREE_MAX_NODES: Source nodes one subscription may monitor in total
# (default: 5000). An oversized maxDepth/subtree registration is rejected, never truncated.
# I3X_SUBSCRIPTION_SUBTREE_MAX_DEPTH is not configurable: monitored subtrees use the same
# composition depth bound as value/history reads (I3X_COMPOSITION_MAX_DEPTH, 0 = no cap).
I3X_SUBSCRIPTION_SUBTREE_MAX_NODES=5000
# I3X_SUBSCRIPTION_NATIVE_MAX_BINS / I3X_SUBSCRIPTION_NATIVE_MAX_MONITORED_ITEMS: Process-local
# floors for native OPC UA admissions, applied when the server advertises no capability variables
# (defaults: 100 bins / 10000 monitored items).
I3X_SUBSCRIPTION_NATIVE_MAX_BINS=100
I3X_SUBSCRIPTION_NATIVE_MAX_MONITORED_ITEMS=10000
# I3X_HISTORY_MAX_RANGE_DAYS: Largest span a history query may request, in days (default: 30,
# 0 = unbounded). An oversized span is rejected as 400 before the upstream is asked, because the
# span is the amount of stored data a single request demands.
I3X_HISTORY_MAX_RANGE_DAYS=30
# Composition limits: how much recursion and how many property sources one request may demand.
# Oversized compositions are rejected as 400 instead of silently truncated.
# I3X_COMPOSITION_MAX_DEPTH: Composition levels a single request may recurse (default: 32, 0 = no cap).
I3X_COMPOSITION_MAX_DEPTH=32
# I3X_COMPOSITION_MAX_NODES: Property sources a single request may fetch (default: 2000, 0 = no cap).
I3X_COMPOSITION_MAX_NODES=2000

# Optional v1 object-type enrichment
# I3X_ENABLE_TYPE_BROWSENAME_LOOKUP: Resolve browse names for inferred object types (default: false).
I3X_ENABLE_TYPE_BROWSENAME_LOOKUP=0
# I3X_TYPE_BROWSENAME_LOOKUP_TIMEOUT_S: Per-lookup timeout in seconds (default: 0.05).
I3X_TYPE_BROWSENAME_LOOKUP_TIMEOUT_S=0.05
# I3X_TYPE_BROWSENAME_LOOKUP_MAX: Max browse-name lookups per request (default: 20).
I3X_TYPE_BROWSENAME_LOOKUP_MAX=20

# Logging
# I3X_LOG_LEVEL: Logging verbosity (default: INFO).
I3X_LOG_LEVEL=INFO
# I3X_LOG_FORMAT: Log rendering (default: text).
# text keeps the historical "asctime level name message" layout; json emits one JSON object per
# line (timestamp/level/logger/message) for log shippers that index structured fields.
I3X_LOG_FORMAT=text

# CORS
# I3X_CORS_ALLOWED_ORIGINS: Allowed CORS origins as a JSON array (default: []).
I3X_CORS_ALLOWED_ORIGINS=[]

# OpenTelemetry
# I3X_OTEL_ENABLED: Enable tracing (default: false).
I3X_OTEL_ENABLED=false
# I3X_OTEL_SERVICE_NAME: Service name the app reports to OpenTelemetry (default: i3x2ua).
# I3X_OTEL_OTLP_ENDPOINT: OTLP collector endpoint the app configures at startup (default: unset).
# OTEL_SERVICE_NAME / OTEL_EXPORTER_OTLP_ENDPOINT take precedence over the I3X_ values when set,
# because the OpenTelemetry SDK reads the standard variables directly.
# OTEL_SERVICE_NAME: Service name reported to OpenTelemetry.
OTEL_SERVICE_NAME=i3x2ua
# OTEL_EXPORTER_OTLP_ENDPOINT: OTLP collector base endpoint (default: empty).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Writes
# I3X_ENABLE_WRITES: Enable current-value and historical REST writes (default: false).
# Historical writes also require HistoryUpdate support and HistoryWrite access on the upstream server.
I3X_ENABLE_WRITES=0
# I3X_WRITE_CONCURRENCY: Concurrent OPC UA write round-trips per bulk current-value request
# (default: 8). Items targeting the same node stay sequential in request order; the mandatory
# VQT read-back is one batched Read after the write phase regardless of this value.
I3X_WRITE_CONCURRENCY=8
# I3X_BASE64_MAX_DECODE_BYTES: Decoded size a base64-encoded ByteString value may reach
# (default: 1048576). Applies to current-value writes, historical writes, and MCP header values;
# oversized payloads are rejected as 400 before decoding, so the bound also limits the memory a
# request can allocate.
I3X_BASE64_MAX_DECODE_BYTES=1048576
# I3X_TRUST_PRINCIPAL_HEADER: Trust the x-principal request header as the audit principal of
# historical writes (default: false, which always audits "anonymous"). Enable only behind a
# proxy that sets the header itself, otherwise any caller can forge audit identity.
I3X_TRUST_PRINCIPAL_HEADER=0

# MCP
# I3X_ENABLE_MCP: Enable MCP support (default: false).
I3X_ENABLE_MCP=0
# I3X_MCP_ALLOWED_ORIGINS: Origins allowed to call MCP routes, as a JSON array (default: []).
# Empty falls back to I3X_CORS_ALLOWED_ORIGINS (without "*"). A request that sends an Origin
# header must match one of these exactly - the server's own host is never an allowed origin.
# Requests without an Origin header (non-browser MCP clients) stay allowed.
I3X_MCP_ALLOWED_ORIGINS=[]
# I3X_MCP_INCLUDE_OPCUA_METADATA: Enables richer Schemas e.g. EnumValues, References, ModelingRules, ...
I3X_MCP_INCLUDE_OPCUA_METADATA=0
# I3X_MCP_MAX_SSE_STREAMS_PER_CLIENT: SSE streams one connecting address may open on the legacy
# MCP transport (default: 8). Over the bound the GET answers 400 with a JSON-RPC error; a stream
# that stops draining its notifications is closed rather than allowed to grow.
I3X_MCP_MAX_SSE_STREAMS_PER_CLIENT=8

# Development and debugging
# I3X_SKIP_OPCUA_CONNECT: Skip the initial OPC UA connection on startup (default: false).
I3X_SKIP_OPCUA_CONNECT=0
# I3X_ALLOW_DEGRADED_STARTUP: Serve even when the first OPC UA connect fails (empty model +
# background retry supervisor). Default false keeps the hard-fail startup behavior.
I3X_ALLOW_DEGRADED_STARTUP=0
# I3X_OPCUA_STARTUP_RETRY_INTERVAL_SECONDS: First retry delay of the startup supervisor;
# delays double per attempt and are capped by I3X_OPCUA_RECONNECT_MAX_DELAY_SECONDS.
I3X_OPCUA_STARTUP_RETRY_INTERVAL_SECONDS=5
# I3X_DEBUG_SUBSCRIPTION_STREAM: Enable verbose subscription stream logging (default: false).
I3X_DEBUG_SUBSCRIPTION_STREAM=0

# Uvicorn / run.py
# I3X_RELOAD: Enable auto-reload for development (default: false).
I3X_RELOAD=0
# I3X_UVICORN_LOOP: Uvicorn event loop override (default: auto/empty).
I3X_UVICORN_LOOP=
# I3X_UVICORN_LIMIT_CONCURRENCY: Concurrent in-flight requests for `run.py`; requests over
# the limit answer 503 instead of queueing on the event loop (default: 200, 0 disables it).
I3X_UVICORN_LIMIT_CONCURRENCY=200
# I3X_UVICORN_GRACEFUL_SHUTDOWN_SECONDS: Seconds `run.py` lets uvicorn wait for in-flight
# requests on termination (default: 30, 0 keeps the unbounded default). The lifespan cleanup
# runs after that wait, so a container also needs a stop_grace_period above drain + cleanup.
I3X_UVICORN_GRACEFUL_SHUTDOWN_SECONDS=30
# I3X_REQUEST_RATE_LIMIT_PER_MINUTE: Requests per minute per client address; 0 disables the
# limiter (default). Tripping it answers 429 with the gateway error envelope. The key is the
# connecting address, and only the trusted proxy addresses listed in I3X_FORWARDED_ALLOW_IPS may
# replace it with the address they report in X-Forwarded-For. Enable a non-zero value when the
# app runs behind such a trusted proxy (the compose stack does, as a second layer behind nginx).
# Behind a proxy that is not listed there every request shares the proxy's address, so limit at
# the proxy instead.
I3X_REQUEST_RATE_LIMIT_PER_MINUTE=0
# I3X_FORWARDED_ALLOW_IPS: Addresses whose X-Forwarded-For / X-Forwarded-Proto headers uvicorn
# trusts when --proxy-headers is set (comma-separated IPs and CIDR ranges). The compose stack uses
# loopback plus the private container networks; "*" would trust every peer and make the client
# address - the rate limiter's key - something the caller chooses. Set this to the proxy's address
# when it sits outside these ranges, and never enable the flag when no proxy fronts the app.
I3X_FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.16.0.0/12

# Certificate mount path
# I3X_OPCUA_CERTS_DIR: Directory for certificate files inside the container (default: ./certs).
I3X_OPCUA_CERTS_DIR=./certs

# Nginx reverse proxy
# Development only: production deployments must enable HTTPS and authentication.
# NGINX_HTTPS_ENABLED: Enable nginx HTTPS support (default: false).
NGINX_HTTPS_ENABLED=0
# NGINX_SERVER_NAME: Hostname served by nginx (default: localhost).
NGINX_SERVER_NAME=localhost
# NGINX_HTTPS_REDIRECT_PORT: HTTPS redirect port (default: 8443).
NGINX_HTTPS_REDIRECT_PORT=8443
# NGINX_SSL_CERTS_DIR: Directory containing TLS certificate files (default: ./certs).
NGINX_SSL_CERTS_DIR=./certs
# NGINX_SSL_CERTIFICATE: Path to the nginx TLS certificate file (default: /etc/nginx/certs/https-sample/fullchain.pem).
NGINX_SSL_CERTIFICATE=/etc/nginx/certs/https-sample/fullchain.pem
# NGINX_SSL_CERTIFICATE_KEY: Path to the nginx TLS private key file (default: /etc/nginx/certs/https-sample/privkey.pem).
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/certs/https-sample/privkey.pem
# NGINX_HTTP_PORT: HTTP port exposed by nginx (default: 80).
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT: HTTPS port exposed by nginx (default: 443).
NGINX_HTTPS_PORT=443
# NGINX_UPSTREAM_HOST: Upstream application hostname for nginx (default: i3x2ua).
NGINX_UPSTREAM_HOST=i3x2ua
# NGINX_UPSTREAM_PORT: Upstream application port for nginx (default: 8000).
NGINX_UPSTREAM_PORT=8000
# NGINX_BASIC_AUTH_ENABLED: Enable nginx basic authentication (default: false).
NGINX_BASIC_AUTH_ENABLED=0
# NGINX_BASIC_AUTH_USER: Username for nginx basic auth (default: empty).
# The compose stack reads this and the password from this file; with
# NGINX_BASIC_AUTH_ENABLED=1 nginx refuses to start while either is empty.
NGINX_BASIC_AUTH_USER=
# NGINX_BASIC_AUTH_PASSWORD: Password for nginx basic auth (default: empty).
NGINX_BASIC_AUTH_PASSWORD=
# NGINX_BASIC_AUTH_REALM: Authentication realm name (default: i3x2ua).
NGINX_BASIC_AUTH_REALM=i3x2ua
