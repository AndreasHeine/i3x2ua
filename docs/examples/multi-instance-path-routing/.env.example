I3X2UA_IMAGE=ghcr.io/andreasheine/i3x2ua:master

I3X_OPCUA_ENDPOINT_1=opc.tcp://opcua-server-1:4840
I3X_OPCUA_ENDPOINT_2=opc.tcp://opcua-server-2:4840
I3X_OPCUA_ENDPOINT_3=opc.tcp://opcua-server-3:4840

# Optional credentials, configured independently for each OPC UA server.
I3X_OPCUA_USERNAME_1=
I3X_OPCUA_PASSWORD_1=
I3X_OPCUA_USERNAME_2=
I3X_OPCUA_PASSWORD_2=
I3X_OPCUA_USERNAME_3=
I3X_OPCUA_PASSWORD_3=

# Security settings can also be overridden per instance with
# I3X_OPCUA_SECURITY_MODE_1/2/3 and I3X_OPCUA_SECURITY_POLICY_1/2/3.
I3X_LOG_LEVEL=INFO

# Optional host ports; default to 80 and 443.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
