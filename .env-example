# Local environment template for i3x_server
# Source of truth: i3x_server/config/settings.py, i3x_server/main.py, run.py

# Network binding
# I3X_HOST: Bind address (default: 0.0.0.0).
I3X_HOST=0.0.0.0
# I3X_PORT: HTTP port (default: 8000).
I3X_PORT=8000

# OPC UA connection
# For Docker Compose, use host.docker.internal instead of 127.0.0.1 when the OPC UA server runs on the host.
# I3X_OPCUA_ENDPOINT: OPC UA endpoint URL (default: opc.tcp://opcua.umati.app:4843).
I3X_OPCUA_ENDPOINT=opc.tcp://opcua.umati.app:4843
# I3X_OPCUA_USERNAME: OPC UA username (default: empty).
I3X_OPCUA_USERNAME=
# I3X_OPCUA_PASSWORD: OPC UA password (default: empty).
I3X_OPCUA_PASSWORD=

# OPC UA security
# I3X_OPCUA_SECURITY_MODE: Security mode (e.g. None, Sign, SignAndEncrypt; default: None).
I3X_OPCUA_SECURITY_MODE=SignAndEncrypt
# I3X_OPCUA_SECURITY_POLICY: Security policy (e.g. Basic256Sha256; default: None).
I3X_OPCUA_SECURITY_POLICY=Basic256Sha256
# I3X_OPCUA_CLIENT_CERT_PATH: Client certificate path (default: None).
I3X_OPCUA_CLIENT_CERT_PATH=./certs/opcua-client-sample/client-cert.pem
# I3X_OPCUA_CLIENT_KEY_PATH: Client key path (default: None).
I3X_OPCUA_CLIENT_KEY_PATH=./certs/opcua-client-sample/client-key.pem
# I3X_OPCUA_CLIENT_KEY_PASSWORD: Client key password (default: empty).
I3X_OPCUA_CLIENT_KEY_PASSWORD=
# I3X_OPCUA_SERVER_CERT_PATH: Server certificate path for validation (default: None).
I3X_OPCUA_SERVER_CERT_PATH=

# OPC UA/model performance tuning
# I3X_OPCUA_BROWSE_CONCURRENCY: Browse concurrency (default: 128).
I3X_OPCUA_BROWSE_CONCURRENCY=128
# I3X_OPCUA_METADATA_CACHE_TTL_SECONDS: Metadata cache TTL in seconds (default: 300).
I3X_OPCUA_METADATA_CACHE_TTL_SECONDS=300
# I3X_OPCUA_CONNECTION_MONITOR_INTERVAL_SECONDS: Connection monitor interval in seconds (default: 5).
I3X_OPCUA_CONNECTION_MONITOR_INTERVAL_SECONDS=5
# I3X_MODEL_REFRESH_INTERVAL_SECONDS: Model refresh interval in seconds (default: 0 = disabled).
I3X_MODEL_REFRESH_INTERVAL_SECONDS=60

# Startup and preload behavior
# I3X_MODEL_PRELOAD_ON_STARTUP: Preload the model on startup (default: true).
I3X_MODEL_PRELOAD_ON_STARTUP=true
# I3X_MODEL_PRELOAD_BLOCKING: Block startup until preload completes (default: false).
I3X_MODEL_PRELOAD_BLOCKING=false
# I3X_FAIL_STARTUP_ON_MODEL_PRELOAD_ERROR: Fail startup on preload errors (default: false).
I3X_FAIL_STARTUP_ON_MODEL_PRELOAD_ERROR=false

# Subscription behavior
# I3X_SUBSCRIPTIONS_INITIAL_VALUES: Seed initial values on subscription registration (default: true).
I3X_SUBSCRIPTIONS_INITIAL_VALUES=true
# I3X_SUBSCRIPTION_INTERVAL_SECONDS: Subscription update interval in seconds (default: 5.0).
I3X_SUBSCRIPTION_INTERVAL_SECONDS=5
# I3X_SUBSCRIPTION_MAX_UPDATES: Max updates retained per subscription (default: 10000).
I3X_SUBSCRIPTION_MAX_UPDATES=10000
# I3X_SUBSCRIPTION_TTL_SECONDS: Subscription TTL in seconds (default: 300).
I3X_SUBSCRIPTION_TTL_SECONDS=300

# Optional v1 object-type enrichment
# I3X_ENABLE_TYPE_BROWSENAME_LOOKUP: Resolve browse names for inferred object types (default: false).
I3X_ENABLE_TYPE_BROWSENAME_LOOKUP=0
# I3X_TYPE_BROWSENAME_LOOKUP_TIMEOUT_S: Per-lookup timeout in seconds (default: 0.05).
I3X_TYPE_BROWSENAME_LOOKUP_TIMEOUT_S=0.05
# I3X_TYPE_BROWSENAME_LOOKUP_MAX: Max browse-name lookups per request (default: 20).
I3X_TYPE_BROWSENAME_LOOKUP_MAX=20

# Logging
# I3X_LOG_LEVEL: Logging verbosity (default: INFO).
I3X_LOG_LEVEL=INFO

# CORS
# I3X_CORS_ALLOWED_ORIGINS: Allowed CORS origins as a JSON array (default: []).
I3X_CORS_ALLOWED_ORIGINS=[]

# OpenTelemetry
# I3X_OTEL_ENABLED: Enable tracing (default: false).
I3X_OTEL_ENABLED=false
# I3X_OTEL_SERVICE_NAME: Service name reported to OpenTelemetry (default: i3x2ua).
I3X_OTEL_SERVICE_NAME=i3x2ua
# I3X_OTEL_OTLP_ENDPOINT: OTLP collector endpoint (default: empty).
I3X_OTEL_OTLP_ENDPOINT=

# MCP
# I3X_ENABLE_MCP: Enable MCP support (default: false).
I3X_ENABLE_MCP=0
# I3X_MCP_INCLUDE_OPCUA_METADATA: Enables richer Schemas e.g. EnumValues, References, ModelingRules, ...
I3X_MCP_INCLUDE_OPCUA_METADATA=0

# Development and debugging
# I3X_SKIP_OPCUA_CONNECT: Skip the initial OPC UA connection on startup (default: false).
I3X_SKIP_OPCUA_CONNECT=0
# I3X_DEBUG_SUBSCRIPTION_STREAM: Enable verbose subscription stream logging (default: false).
I3X_DEBUG_SUBSCRIPTION_STREAM=0

# Uvicorn / run.py
# I3X_RELOAD: Enable auto-reload for development (default: false).
I3X_RELOAD=0
# I3X_UVICORN_LOOP: Uvicorn event loop override (default: auto/empty).
I3X_UVICORN_LOOP=

# Certificate mount path
# I3X_OPCUA_CERTS_DIR: Directory for certificate files inside the container (default: ./certs).
I3X_OPCUA_CERTS_DIR=./certs

# Nginx reverse proxy
# NGINX_HTTPS_ENABLED: Enable nginx HTTPS support (default: false).
NGINX_HTTPS_ENABLED=0
# NGINX_SERVER_NAME: Hostname served by nginx (default: localhost).
NGINX_SERVER_NAME=localhost
# NGINX_HTTPS_REDIRECT_PORT: HTTPS redirect port (default: 8443).
NGINX_HTTPS_REDIRECT_PORT=8443
# NGINX_SSL_CERTS_DIR: Directory containing TLS certificate files (default: ./certs).
NGINX_SSL_CERTS_DIR=./certs
# NGINX_SSL_CERTIFICATE: Path to the nginx TLS certificate file (default: /etc/nginx/certs/https-sample/fullchain.pem).
NGINX_SSL_CERTIFICATE=/etc/nginx/certs/https-sample/fullchain.pem
# NGINX_SSL_CERTIFICATE_KEY: Path to the nginx TLS private key file (default: /etc/nginx/certs/https-sample/privkey.pem).
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/certs/https-sample/privkey.pem
# NGINX_HTTP_PORT: HTTP port exposed by nginx (default: 80).
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT: HTTPS port exposed by nginx (default: 443).
NGINX_HTTPS_PORT=443
# NGINX_UPSTREAM_HOST: Upstream application hostname for nginx (default: i3x2ua).
NGINX_UPSTREAM_HOST=i3x2ua
# NGINX_UPSTREAM_PORT: Upstream application port for nginx (default: 8000).
NGINX_UPSTREAM_PORT=8000
# NGINX_BASIC_AUTH_ENABLED: Enable nginx basic authentication (default: false).
NGINX_BASIC_AUTH_ENABLED=0
# NGINX_BASIC_AUTH_USER: Username for nginx basic auth (default: empty).
NGINX_BASIC_AUTH_USER=
# NGINX_BASIC_AUTH_PASSWORD: Password for nginx basic auth (default: empty).
NGINX_BASIC_AUTH_PASSWORD=
# NGINX_BASIC_AUTH_REALM: Authentication realm name (default: i3x2ua).
NGINX_BASIC_AUTH_REALM=i3x2ua
