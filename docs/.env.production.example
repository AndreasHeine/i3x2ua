# Production Environment Configuration Example

# ============================================================================
# NGINX Configuration
# ============================================================================

# HTTPS/SSL Settings
NGINX_HTTPS_ENABLED=1
NGINX_SERVER_NAME=api.your-domain.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# SSL Certificate Paths
NGINX_SSL_CERTIFICATE=/etc/nginx/certs/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem
NGINX_SSL_CERTS_DIR=./certs

# ============================================================================
# Authentication Configuration
# ============================================================================

# BasicAuth (set to 1 to enable)
NGINX_BASIC_AUTH_ENABLED=1
NGINX_BASIC_AUTH_USER=apiuser
NGINX_BASIC_AUTH_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
NGINX_BASIC_AUTH_REALM=i3x2ua API Access

# OAuth 2.0 Configuration (optional)
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_ISSUER_URL=https://accounts.google.com
# OAUTH_ALLOWED_EMAILS=admin@company.com,user@company.com

# ============================================================================
# OPC-UA Configuration for Each Instance
# ============================================================================

# Instance 1 - OPC-UA Connection
I3X_OPCUA_ENDPOINT_1=opc.tcp://your-opcua-server-1:4843
I3X_OPCUA_USERNAME_1=your-opcua-username-1
I3X_OPCUA_PASSWORD_1=your-opcua-password-1
I3X_OPCUA_SECURITY_MODE_1=None
I3X_OPCUA_SECURITY_POLICY_1=

# Instance 2 - OPC-UA Connection  
I3X_OPCUA_ENDPOINT_2=opc.tcp://your-opcua-server-2:4843
I3X_OPCUA_USERNAME_2=your-opcua-username-2
I3X_OPCUA_PASSWORD_2=your-opcua-password-2
I3X_OPCUA_SECURITY_MODE_2=None
I3X_OPCUA_SECURITY_POLICY_2=

# Instance 3 - OPC-UA Connection
I3X_OPCUA_ENDPOINT_3=opc.tcp://your-opcua-server-3:4843
I3X_OPCUA_USERNAME_3=your-opcua-username-3
I3X_OPCUA_PASSWORD_3=your-opcua-password-3
I3X_OPCUA_SECURITY_MODE_3=None
I3X_OPCUA_SECURITY_POLICY_3=

# ============================================================================
# Logging
# ============================================================================

I3X_LOG_LEVEL=INFO

# ============================================================================
# Grafana Configuration (Optional - for monitoring)
# ============================================================================

# GRAFANA_PASSWORD=your-grafana-admin-password

# ============================================================================
# Docker-Specific Settings
# ============================================================================

# Image versions
I3X2UA_IMAGE=ghcr.io/andreasheine/i3x2ua:master
NGINX_IMAGE=nginx:1.31-alpine

# Container restart policies
RESTART_POLICY=unless-stopped

# ============================================================================
# Security Settings
# ============================================================================

# Enable Read-Only Filesystem for Containers
CONTAINER_READ_ONLY=true

# Process Limits
CONTAINER_PID_LIMIT=256

# Memory Limits (e.g., 512m, 1g)
# MEMORY_LIMIT=512m

# ============================================================================
# Network Configuration
# ============================================================================

# Network driver
NETWORK_DRIVER=bridge

# ============================================================================
# Notes
# ============================================================================

# 1. Replace all "your-*" values with actual configuration
# 2. Store this file securely - it contains sensitive credentials
# 3. Never commit the actual .env file to version control
# 4. Use .env.example or .env.production.example for templates
# 5. For production, use strong passwords (at least 16 characters)
# 6. Rotate credentials regularly
# 7. Use environment-specific .env files (.env.prod, .env.staging, etc.)

# Multi-Instance Setup Notes:
# - Each instance runs independently with its own OPC-UA connection
# - Instance 1 accessible at: https://your-domain.com/i3x/instance1/v1/...
# - Instance 2 accessible at: https://your-domain.com/i3x/instance2/v1/...
# - Instance 3 accessible at: https://your-domain.com/i3x/instance3/v1/...
# - No shared database or state between instances
# - Each instance can connect to a different OPC-UA server
# - Use docker-compose.multi-instance.yml for multi-instance deployment

# Example strong password generation:
# openssl rand -base64 32
